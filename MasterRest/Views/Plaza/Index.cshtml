@model IEnumerable<MasterRest.Models.mPlaza>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Lista de posiciones</h4>
                <h6>Gestiona tus posiciones</h6>
            </div>
        </div>
        <ul class="table-top-head">
            <li>
                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Excel" href="~/Report/Positions"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
            </li>
            <li>
                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh" href="~/mPlaza"><i class="ti ti-refresh"></i></a>
            </li>
            <li>
                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Collapse" id="collapse-header"><i class="ti ti-chevron-up"></i></a>
            </li>
        </ul>
        <div class="page-btn">
            <a href="javascript:AbreModal3('@Url.Action("Create","mPlaza")','Agregar posición');" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Agregar plaza</a>
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14 feather-search"></i></span>
                </div>
            </div>
            <div class="d-flex table-dropdown my-xl-auto right-content align-items-center flex-wrap row-gap-3">
                
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table datatable" style="width:100%" id="tbl">
                    <thead>
                        <tr>
                            <th width="1"></th>
                            <th>Estatus</th>
                            <th><strong>Puesto</strong></th>
                            <th>Área</th>
                            <th>Sucursal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <a class="action-set" href="javascript:void(0);" data-bs-toggle="dropdown" aria-expanded="true"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></a>
                                    <ul class="dropdown-menu">
                                        <li><a href="javascript:AbreModal3('@Url.Action("Details", "mPlaza", new { id = item.idmPlaza })','Detalle de la posición');" class="dropdown-item"><i data-feather="eye" class="info-img"></i>Detalle</a></li>
                                        <li><a href="javascript:AbreModal3('@Url.Action("Edit", "mPlaza", new { id = item.idmPlaza })','Editar posición');" class="dropdown-item"><i data-feather="edit" class="info-img"></i>Editar</a></li>
                                        <li><a href="javascript:AbreModal('@Url.Action("DeActivate", "mPlaza", new { id = item.idmPlaza })','Desactivar posición');" class="dropdown-item"><i data-feather="minus-circle" class="info-img"></i>Desactivar</a></li>
                                        <li><a href="javascript:AbreModal('@Url.Action("DeActivate", "mPlaza", new { id = item.idmPlaza })','Activar posición');" class="dropdown-item"><i data-feather="check-circle" class="info-img"></i>Activar</a></li>
                                    </ul>
                                </td>
                                <td><span class="badge bg-@(item.estatus == "ASIGNADA" ? "success" : (item.estatus == "VACANTE" ? "secondary" : "warning")) fw-medium me-1">@item.estatus</span></td>
                                @{
                                    var nombreCompleto = item.mEmpleado != null ? item.mEmpleado.nombre + " " + item.mEmpleado.paterno + " " + item.mEmpleado.materno : "";

                                    if (item.estatus != "ASIGNADA")
                                    {
                                        var eEmpleadoBajas = (List<MasterRest.Models.eEmpleadoBaja>)ViewBag.eEmpleadoBaja;

                                        var eEmpleadoBaja = eEmpleadoBajas.Where(_ => _.idmPlaza == item.idmPlaza).LastOrDefault();

                                        nombreCompleto = eEmpleadoBaja != null && eEmpleadoBaja.mEmpleado != null ? eEmpleadoBaja.mEmpleado.nombre + " " + eEmpleadoBaja.mEmpleado.paterno + " " + eEmpleadoBaja.mEmpleado.materno : "";
                                    }
                                }
                                <td><strong>@item.cPuesto.puesto</strong><br><div style="font-size: 10px;">@nombreCompleto</div></td>
                                <td>@item.cArea.area</td>
                                <td>@item.cSucursal.sucursal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function OnChangeEstatusEmpresa(value) {
        var form = document.createElement("form");
        var element1 = document.createElement("input");
        var element2 = document.createElement("input");
        form.method = "POST";
        form.action = "@Url.Action("Index", "mPlaza")";
        element1.value = $("#estatus").val();
        element1.name = "estatus";
        form.appendChild(element1);
        element2.value = $("#centroTrabajo2").val();
        element2.name = "centroTrabajo";
        form.appendChild(element2);
        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    var tbl = $("#tbl").DataTable({
        "pagingType": 'simple_numbers',
        "language": {
            "sProcessing": "Procesando...",
            "sLengthMenu": "Mostrar _MENU_ registros",
            "sZeroRecords": "No se encontraron resultados",
            "sEmptyTable": "Ningún dato disponible en esta tabla",
            "sInfo": "",
            "sInfoEmpty": "",
            "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
            "sInfoPostFix": "",
            "sSearch": "Buscar",
            "sUrl": "",
            "sInfoThousands": ",",
            "sLoadingRecords": "Cargando..."
        },
        "displayLength": 10,
        initComplete: function () {
            $(this.api().table().container()).find('input').parent().wrap('<form>').parent().attr('autocomplete', 'off');
        },
        "order": [[0, 'desc']],
        "columnDefs": [{ target: 0, visible: false }]
    });

    $(document).ready(function () {
        if ('@ViewBag.buscar' != '') {
            tbl.search('@ViewBag.buscar').draw();
        }
    });
</script>