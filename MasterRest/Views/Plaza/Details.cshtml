@model MasterRest.Models.mPlaza
@{
    Layout = null;
}
<div class="alert mb-0" role="alert">
    <div class="form-horizontal">
        <div class="nav-align-top mb-4">
            <ul class="nav nav-tabs default-tabs mb-3">
                <li class="nav-item"><a href="#tab1" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">Plaza</a></li>
                <li class="nav-item"><a href="#tab2" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Beneficios</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane show active" id="tab1">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <b>Empleado</b><br />@if (Model.mEmpleado != null) { @(Model.mEmpleado.nombre + " " + Model.mEmpleado.paterno + " " + Model.mEmpleado.materno ) } else { <b>&nbsp;</b> }
                        </div>
                        <div class="col-md-4">
                            <b>Estatus</b><br /><span class="badge bg-@(Model.estatus == "ACTIVO" ? "success" : (Model.estatus == "VACANTE" ? "secondary" : "warning")) fw-medium me-1">@Model.estatus</span>
                        </div>
                        <div class="col-md-4">
                            <b>Sucursal</b><br />@if (Model.cSucursal != null) { @Model.cSucursal.sucursal } else { <b>&nbsp;</b> }
                        </div>
                    </div>
                    <hr />
                    <div class="form-group row">
                        <div class="col-md-4">
                            <b>Puesto</b><br />@if (Model.cPuesto != null) { @Model.cPuesto.puesto } else { <b>&nbsp;</b> }
                        </div>
                        <div class="col-md-4">
                            <b>Área</b><br />@if (Model.cArea != null) { @Model.cArea.area } else { <b>&nbsp;</b> }
                        </div>
                        <div class="col-md-4">
                            <b>Rol</b><br />@if (Model.cRol != null) { @Model.cRol.rol } else { <b>&nbsp;</b>}
                        </div>
                    </div>
                    <hr />
                    <div class="form-group row">
                        <div class="col-md-4"><b>Jefe inmediato</b><br />@ViewBag.jefeInmediatoPuesto<br />@ViewBag.idmPlazaJefeInmediato</div>
                    </div>
                </div>
                <div class="tab-pane" id="tab2">
                    @if (Model.ePlazaBeneficio.Count > 0)
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Beneficio</th>
                                    <th>Tipo</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.ePlazaBeneficio)
                                {
                                    <tr>
                                        <th>@b.cBeneficio.beneficio</th>
                                        <th>@b.tipo</th>
                                        <th>@b.valor</th>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No tiene beneficios</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>