@model MasterRest.Models.mPlaza
@{
    Layout = null;
}
<style>
    .required::after
    {
        content: " *";
        font-weight: bold;
        color: red;
    }
</style>
@using (Html.BeginForm(new { onsubmit = "return loading();" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.Hidden("estatus", "VACANTE")
        <div class="nav-align-top mb-4">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-1" aria-controls="navs-top-1" aria-selected="true">Plantilla</button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-2" aria-controls="navs-top-2" aria-selected="false">Herramientas y funciones</button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-3" aria-controls="navs-top-3" aria-selected="false">Beneficios</button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="navs-top-1" role="tabpanel">
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            <label class="control-label col-md-12" style="font-weight:bold">ID PUESTO</label>
                            <span style="color:white">|</span><span id="DIR"></span><span id="ARE"></span><span id="UBI"></span><span id="MER"></span><span id="PUE"></span>
                            @Html.TextBoxFor(model => model.idPosicion, new { @class = "form-control", @type = "hidden" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.direccion, "Dirección", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("direccion", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select", @required = "*", @onchange = "OnChangeDireccion(this)" })
                            @Html.ValidationMessageFor(model => model.direccion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.area, "Área", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("area", new SelectList(string.Empty, "Value", "Text"), "SELECCIONE...", htmlAttributes: new { @class = "form-select", @required = "*", @onchange = "OnChangeArea(this)" })
                            @Html.ValidationMessageFor(model => model.area, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.departamento, "Departamento", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("departamento", new SelectList(string.Empty, "Value", "Text"), "SELECCIONE...", htmlAttributes: new { @class = "form-select", @required = "*", @onchange = "OnChangeDepartamento(this)" })
                            @Html.ValidationMessageFor(model => model.departamento, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.puesto, "Puesto", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("puesto", new SelectList(string.Empty, "Value", "Text"), "SELECCIONE...", htmlAttributes: new { @class = "form-select", @required = "*", @onchange = "OnChangePuesto(this)" })
                            @Html.ValidationMessageFor(model => model.puesto, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.idmPlazaJefeInmediato, "Jefe inmediato", htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold" })
                            @Html.DropDownList("idmPlazaJefeInmediato", new SelectList(string.Empty, "Value", "Text"), "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.idmPlazaJefeInmediato, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.jerarquia, "Jerarquía", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("jerarquia", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.jerarquia, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.centroCostos, "Centro de costos", htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold" })
                            @Html.DropDownList("centroCostos", new SelectList(string.Empty, "Value", "Text"), "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.centroCostos, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.programa, "Programa", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("programa", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.programa, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.facturar, "Facturar", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("facturar", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.facturar, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.clasificacion, "Clasificación", htmlAttributes: new { @class = "control-label col-md-12", @style = "font-weight:bold" })
                            @Html.DropDownList("clasificacion", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.clasificacion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.centroTrabajo, "Centro de trabajo", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("centroTrabajo", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*", @onchange = "OnChangeCentroTrabajo(this)" })
                            @Html.ValidationMessageFor(model => model.centroTrabajo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.empresaGV, "Empresa", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("empresaGV", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.empresaGV, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.nivelMercer, "Nivel mercer", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("nivelMercer", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*", @onchange = "OnChangeNivelMercer(this)" })
                            @Html.ValidationMessageFor(model => model.nivelMercer, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.presupuestoAutorizado, "Presupuesto autorizado", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.presupuestoAutorizado, new { @class = "form-control", @type = "number", @min = 0, @max = 9999999, @required = "*", @onkeyup = "validNumberRange(this, 0, 9999999);" })
                            @Html.ValidationMessageFor(model => model.presupuestoAutorizado, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.idcRol, "Rol", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("idcRol", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.idcRol, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.agencia, "Agencia", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("agencia", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.agencia, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.patronal, "Patronal", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.DropDownList("patronal", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*" })
                            @Html.ValidationMessageFor(model => model.patronal, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4">
                            @Html.Label("Número de posiciones", htmlAttributes: new { @class = "control-label col-md-12 required", @style = "font-weight:bold" })
                            @Html.TextBox("numeroPosiciones", null, new { @class = "form-control", @type = "number", @Value = "1", @min = 1, @max = 499, @required = "*", @onkeyup = "if(this.value>499){this.value='499';}else if(this.value<1){this.value='1';}" })
                            @Html.ValidationMessage("numeroPosiciones", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="navs-top-2" role="tabpanel">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label><b>Herramientas de trabajo</b></label><br />
                            @foreach (var _ in ViewBag.herramientasTrabajo)
                            {
                                var ht = ((string)_.herramientasTrabajo).Replace(" ", "_");
                                <div class="col-md-12">
                                    <input type="checkbox" class="form-check-input" id="@ht" name="@ht" onchange="herramientasTrabajo(this)" /><label style="font-size:12px; font-weight:bold" for="@ht">&nbsp;&nbsp;@_.herramientasTrabajo</label>
                                </div>
                            }
                            <div style="display:none" id="divOtraHerramientaTrabajo">
                                @Html.TextBoxFor(model => model.otraHerramientaTrabajo, new { @class = "form-control", @maxlength = 150, @onkeyup = "this.value = textUppercase(this.value);" })
                                @Html.ValidationMessageFor(model => model.otraHerramientaTrabajo, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-8">
                            @Html.LabelFor(model => model.funcionesPuesto, "funciones del puesto", htmlAttributes: new { @class = "control-label col-md-8", @style = "font-weight:bold" })
                            @Html.TextAreaFor(model => model.funcionesPuesto, new { @class = "form-control", @onkeyup = "this.value = textUppercase(this.value);" })
                            @Html.ValidationMessageFor(model => model.funcionesPuesto, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="navs-top-3" role="tabpanel">
                    @{
                        var total = ViewBag.beneficio.Count;
                        var totalx = total % 3 > 0 ? total / 3 + 1 : total / 3;
                        var i = 0;
                        for (int a = 0; a < totalx; a++)
                        {
                            <div class="form-group row">
                                @for (int b = 0; b < 3; b++)
                                {
                                    if (i < total)
                                    {
                                        <div class="col-md-4">
                                            <input type="checkbox" class="form-check-input" id="check-@ViewBag.beneficio[i].idcBeneficio" name="check-@ViewBag.beneficio[i].idcBeneficio" onclick="OnClickTextVisible(this, '@ViewBag.beneficio[i].idcBeneficio');" />
                                            <label style="font-size:12px; font-weight:bold" for="check-@ViewBag.beneficio[i].idcBeneficio"> @ViewBag.beneficio[i].beneficio</label>
                                            @if (ViewBag.beneficio[i].tipo == "IMPORTE" || ViewBag.beneficio[i].tipo == "PORCENTAJE")
                                            {
                                                <div id="div-@ViewBag.beneficio[i].idcBeneficio" style="display:none">
                                                    <div class="input-group" style="width:120px;">
                                                        @if (ViewBag.beneficio[i].tipo == "IMPORTE")
                                                        {
                                                            <span class="input-group-text">$</span>
                                                        }
                                                        <input type="text" class="form-control" id="input-@ViewBag.beneficio[i].idcBeneficio" name="input-@ViewBag.beneficio[i].idcBeneficio" maxlength="6" onkeypress="return validNumbers2(event);">
                                                        @if (ViewBag.beneficio[i].tipo == "PORCENTAJE")
                                                        {
                                                            <span class="input-group-text">%</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (ViewBag.beneficio[i].tipo == "LISTA")
                                            {
                                                var opciones = ViewBag.beneficio[i].opciones.Split(',');

                                                <div id="div-@ViewBag.beneficio[i].idcBeneficio" style="display:none">
                                                    <select class="form-select " id="input-@ViewBag.beneficio[i].idcBeneficio" name="input-@ViewBag.beneficio[i].idcBeneficio" style="width:120px;">
                                                        <option value=""></option>
                                                        @foreach (var opcion in opciones)
                                                        {
                                                            <option value="@opcion">@opcion</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-6"></div>
                                    }
                                    i++;
                                }
                            </div>
                            <br />
                        }
                    }
                </div>
            </div>
        </div>
        <div class="form-group col-md-12">
            <div style="position: relative; float: right;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<script src="~/assets/js/a-valid-input.js"></script>

<script type="text/javascript">

    $(function () {
        $("#puesto").select2({ dropdownParent: $('#myModal3') });
        $("#idmPlazaJefeInmediato").select2({ dropdownParent: $('#myModal3') });
        $("#idcRol").select2({ dropdownParent: $('#myModal3') });
        $("#area").select2({ dropdownParent: $('#myModal3') });
        $("#departamento").select2({ dropdownParent: $('#myModal3') });
        $("#jerarquia").select2({ dropdownParent: $('#myModal3') });
        $("#direccion").select2({ dropdownParent: $('#myModal3') });
        $("#centroCostos").select2({ dropdownParent: $('#myModal3') });
        $("#programa").select2({ dropdownParent: $('#myModal3') });
        $("#facturar").select2({ dropdownParent: $('#myModal3') });
        $("#clasificacion").select2({ dropdownParent: $('#myModal3') });
        $("#centroTrabajo").select2({ dropdownParent: $('#myModal3') });
        $("#nivelMercer").select2({ dropdownParent: $('#myModal3') });
        $("#empresaGV").select2({ dropdownParent: $('#myModal3') });
    });

    function herramientasTrabajo(e) {
        if (e.id == "OTRO(S)") {
            document.getElementById("divOtraHerramientaTrabajo").style.display = e.checked ? "block" : "none";
            document.getElementById("otraHerramientaTrabajo").value = "";
        }
    }

    function OnChangeDireccion(e) {
        $("#direccion").val(e.options[e.selectedIndex].innerHTML);
        $("#area").empty();
        $("#departamento").empty();
        $("#departamento").append('<option value="">SELECCIONE...</option>');
        $("#puesto").empty();
        $("#puesto").append('<option value="">SELECCIONE...</option>');
        $("#idmPlazaJefeInmediato").empty();
        $("#centroCostos").empty();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("area", "mPlaza")',
            dataType: 'json',
            data: { direccion: e.value },
            success: function (items) {
                $("#area").append('<option value="">SELECCIONE...</option>');
                $.each(items.area, function (i, x) {
                    $("#area").append('<option value="' + x.area + '">' + x.area + '</option>');
                });
                $("#idmPlazaJefeInmediato").append('<option value="">SELECCIONE...</option>');
                $.each(items.idmPlazaJefeInmediato, function (i, x) {
                    $("#idmPlazaJefeInmediato").append('<option value="' + x.idmPlaza + '">' + x.puesto + '</option>');
                });
                $("#centroCostos").append('<option value="">SELECCIONE...</option>');
                $.each(items.cc, function (i, x) {
                    $("#centroCostos").append('<option value="' + x.centroCostos + '">' + x.description + '</option>');
                });
            }
        });

        $("#DIR").text("");
        $("#ARE").text("");
        $("#PUE").text("");
        if (e.value != "") {
            var claves = @Html.Raw(Json.Encode(ViewBag.direccionClaves));
            $.each(claves, function (i, item) {
                if (item.texto == e.value) {
                    $("#DIR").text(item.clave);
                }
            });
        }
        readIdPosicion();
    }

    function OnChangeArea(e) {
        $("#area").val(e.options[e.selectedIndex].innerHTML);
        $("#departamento").empty();
        $("#puesto").empty();
        $("#puesto").append('<option value="">SELECCIONE...</option>');
        $.ajax({
            type: 'POST',
            url: '@Url.Action("departamento", "mPlaza")',
            dataType: 'json',
            data: { area: e.value },
            success: function (items) {
                $("#departamento").append('<option value="">SELECCIONE...</option>');
                $.each(items, function (i, item) {
                    $("#departamento").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });

        $("#ARE").text("");
        $("#PUE").text("");
        if (e.value != "") {
            var claves = @Html.Raw(Json.Encode(ViewBag.areaClaves));
            $.each(claves, function (i, item) {
                if (item.texto == e.value) {
                    $("#ARE").text(item.clave);
                }
            });
        }
        readIdPosicion();
    }

    function OnChangeDepartamento(e) {
        $("#departamento").val(e.options[e.selectedIndex].innerHTML);
        $("#puesto").empty();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("puesto", "mPlaza")',
            dataType: 'json',
            data: { departamento: e.value },
            success: function (items) {
                $("#puesto").append('<option value="">SELECCIONE...</option>');
                $.each(items, function (i, item) {
                    $("#puesto").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });

        $("#PUE").text("");
        readIdPosicion();
    }

    function OnChangePuesto(e) {
        $("#PUE").text("");
        if (e.value != "") {
            var claves = @Html.Raw(Json.Encode(ViewBag.puestoClaves));
            $.each(claves, function (i, item) {
                if (item.texto == e.value) {
                    $("#PUE").text(item.clave);
                }
            });
        }
        readIdPosicion();
    }

    function OnChangeCentroTrabajo(e) {
        $("#UBI").text("");
        if (e.value != "") {
            var claves = @Html.Raw(Json.Encode(ViewBag.centroTrabajoClaves));
            $.each(claves, function (i, item) {
                if (item.texto == e.value) {
                    $("#UBI").text(item.clave);
                }
            });
        }
        readIdPosicion();
    }

    function OnChangeNivelMercer(e) {
        $("#MER").text("");
        if (e.value != "") {
            var claves = @Html.Raw(Json.Encode(ViewBag.nivelMercerClaves));
            $.each(claves, function (i, item) {
                if (item.texto == e.value) {
                    $("#MER").text(item.clave);
                }
            });
        }
        readIdPosicion();
    }

    function readIdPosicion() {
        $("#idPosicion").val($("#DIR").text() + $("#ARE").text() + $("#UBI").text() + $("#MER").text() + $("#PUE").text());
    }

    function OnClickTextVisible(cb, input) {
        document.getElementById('div-' + input).style.display = cb.checked ? "block" : "none";
        document.getElementById('input-' + input).value = "";
    }

</script>