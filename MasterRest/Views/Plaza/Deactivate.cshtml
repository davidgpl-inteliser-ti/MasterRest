@model MasterRest.Models.mPlaza
@{
    Layout = null;
}
@using (Html.BeginForm(new { onsubmit = "return loading();" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.idmPlaza)
        @Html.HiddenFor(model => model.idcEmpresa)
        @Html.HiddenFor(model => model.idcSucursal)
        @Html.HiddenFor(model => model.idmEmpleado)
        @Html.HiddenFor(model => model.idcRol)
        @Html.HiddenFor(model => model.idmPlazaJefeInmediato)
        @Html.HiddenFor(model => model.idcPuesto)
        @Html.HiddenFor(model => model.idcArea)
        @Html.TextBoxFor(model => model.estatus, new { @type = "hidden", @Id = "estatus2" })
        <div class="form-group row">
            <div class="col-md-12">
                <center style="color:dodgerblue;font-size:16px;">@Model.cPuesto.puesto</center>
            </div>
        </div>
        <hr />
        <br />
        <div class="form-group" style="position: relative; float: right;">
            <div class="col-md-12">
                @if (Model.estatus == "INACTIVO")
                {
                    <button type="submit" class="btn btn-primary" onclick="OnClick('VACANTE')">ACTIVAR</button>
                }
                else
                {
                    <button type="submit" class="btn btn-outline-warning" onclick="OnClick('INACTIVO')">DESACTIVAR</button>
                }
            </div>
        </div>
    </div>
}
<script>
    function OnClick(estatus) {
        $("#estatus2").val(estatus);
    }
</script>
