@model MasterRest.Models.mPlaza
@{
    Layout = null;
}
@using (Html.BeginForm(new { onsubmit = "return loading();" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.idmPlaza)
        @Html.HiddenFor(model => model.empresaGV)
        @Html.HiddenFor(model => model.idmEmpleado)
        @Html.HiddenFor(model => model.idcRol)
        @Html.HiddenFor(model => model.idmPlazaJefeInmediato)
        @Html.HiddenFor(model => model.idPosicion)
        @Html.HiddenFor(model => model.puesto)
        @Html.HiddenFor(model => model.nivelMercer)
        @Html.HiddenFor(model => model.centroTrabajo)
        @Html.HiddenFor(model => model.area)
        @Html.HiddenFor(model => model.direccion)
        @Html.HiddenFor(model => model.jerarquia)
        @Html.HiddenFor(model => model.departamento)
        @Html.HiddenFor(model => model.centroCostos)
        @Html.HiddenFor(model => model.programa)
        @Html.HiddenFor(model => model.facturar)
        @Html.HiddenFor(model => model.agencia)
        @Html.HiddenFor(model => model.patronal)
        @Html.HiddenFor(model => model.clasificacion)
        @Html.HiddenFor(model => model.funcionesPuesto)
        @Html.HiddenFor(model => model.presupuestoAutorizado)
        @Html.HiddenFor(model => model.otraHerramientaTrabajo)
        @Html.HiddenFor(model => model.fechaCreacion)
        @Html.TextBoxFor(model => model.estatus, new { @type = "hidden", @Id = "estatus2" })
        <div class="form-group row">
            <div class="col-md-12">
                <center style="color:dodgerblue;font-size:16px;">@Model.puesto</center>
            </div>
        </div>
        <hr />
        <br />
        <div class="form-group" style="position: relative; float: right;">
            <div class="col-md-12">
                @if (Model.estatus == "INACTIVA")
                {
                    <button type="submit" class="btn btn-primary" onclick="OnClick('VACANTE')">ACTIVAR</button>
                }
                else
                {
                    <button type="submit" class="btn btn-outline-warning" onclick="OnClick('INACTIVA')">DESACTIVAR</button>
                }
            </div>
        </div>
    </div>
}
<script>
    function OnClick(estatus) {
        $("#estatus2").val(estatus);
    }
</script>
