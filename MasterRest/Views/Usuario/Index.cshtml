@model IEnumerable<MasterRest.Controllers.UsuarioController.Usuarios>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .dropdown-menu.show
    {
        position: fixed !important;
    }
</style>
<div class="content">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Lista de usuarios</h4>
            </div>
        </div>
        <ul class="table-top-head">
            <li>
                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh" href="~/Empleado"><i class="ti ti-refresh"></i></a>
            </li>
            <li>
                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Collapse" id="collapse-header"><i class="ti ti-chevron-up"></i></a>
            </li>
        </ul>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14 feather-search"></i></span>
                </div>
            </div>
            <div class="d-flex table-dropdown my-xl-auto right-content align-items-center flex-wrap row-gap-3">

            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover" id="tblCat">
                    <thead>
                        <tr>
                            <th width="1"></th>
                            <th>Estatus</th>
                            <th><strong>nombre</strong></th>
                            <th><strong>Usuario</strong></th>
                            <th>Rol</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <a class="action-set" href="javascript:void(0);" data-bs-toggle="dropdown" aria-expanded="true"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></a>
                                    <ul class="dropdown-menu">
                                        @if (item.usuario == "sin usuario")
                                        {
                                            <li><a href="javascript:AbreModal('@Url.Action("Create", "Usuario", new { id = item.idmEmpleado })','Nuevo');" class="dropdown-item"><i data-feather="file" class="info-img"></i>Nuevo</a></li>
                                        }
                                        else
                                        {
                                            <li><a href="javascript:AbreModal('@Url.Action("Edit", "Usuario", new { id = item.idcUsuario })','Editar');" class="dropdown-item"><i data-feather="edit" class="info-img"></i>Editar</a></li>
                                        }
                                    </ul>
                                </td>
                                <td><span class="badge bg-@(item.estatus == "ACTIVO" ? "success" : "warning") fw-medium me-1">@item.estatus</span></td>
                                <td><strong>@item.nombre</strong></td>
                                <td style="color: @(item.usuario == "sin usuario" ? "orange" : "")">@item.usuario</td>
                                <td>@item.rol</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    $("#tblCat").DataTable({
        "pagingType": 'simple_numbers',
        "language": {
            "sProcessing": "Procesando...",
            "sLengthMenu": "Mostrar _MENU_ registros",
            "sZeroRecords": "No se encontraron resultados",
            "sEmptyTable": "Ningún dato disponible en esta tabla",
            "sInfo": "",
            "sInfoEmpty": "",
            "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
            "sInfoPostFix": "",
            "sSearch": "Buscar",
            "sUrl": "",
            "sInfoThousands": ",",
            "sLoadingRecords": "Cargando..."
        },
        "displayLength": 10,
        initComplete: function () {
            $(this.api().table().container()).find('input').parent().wrap('<form>').parent().attr('autocomplete', 'off');
        },
        "order": [[1, 'asc']]
    });
</script>