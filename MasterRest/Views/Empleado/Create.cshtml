    function addModalHEX() {
        if ($("#fechaNacimientoHijos").val() != "") {
            var fnh = $("#fechaNacimientoHijos").val().split('-');
            var f = fnh[2] + "/" + fnh[1] + "/" + fnh[0];
            var sh = $("#sexoHijos").val();
            if ($("#hijos").val() > $('#shijosEdadXML option').length) {
                $("#shijosEdadXML").prepend("<option value='" + f + " - " + sh + "' selected='selected'>" + f + " - " + sh + "</option>");
                hijosEdadXML();
                swal("Agregada exitosamente", "Agregó la fecha " + f + " - " + sh, "success");
            } else {
                swal("Solo puedes agregar " + $("#hijos").val(), "Si quieres agregar más, aumenta el numero de hijos.", "error");
            }
        } else {
            swal("Fecha vacia", "Debe agregar una fecha.", "error");
        }
    }

