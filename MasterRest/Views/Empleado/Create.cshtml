    function OnChangePuesto(idmPlantilla) {

        document.getElementById('divBeneficios').style.display = idmPlantilla == null || idmPlantilla == "" ? "none" : "block";

        idmPlantilla = idmPlantilla == null || idmPlantilla == "" ? 0 : idmPlantilla;
        $.ajax({
            type: 'GET',
            url: '@Url.Action("beneficiosPorPlantilla", "Empleado")',
            dataType: 'json',
            data: { idmPlantilla: idmPlantilla },
            success: function (r) {

                $("#patronal").val(r.patronal).change();

                $("#jefeInmediato").empty();
                $("#jefeInmediato").append('<option value="">SELECCIONE...</option>');
                $.each(r.jefeInmediato, function (i, ji) {
                    $("#jefeInmediato").append('<option value="' + ji.idmPlantilla + '">' + ji.puesto + '</option>');
                });

                $.each(r.cbeneficio, function (i, cb) {
                    document.getElementById('check-' + cb.idcBeneficio).checked = false;
                    document.getElementById('div-' + cb.idcBeneficio).style.display = "none";
                    document.getElementById('input-' + cb.idcBeneficio).value = "";
                });

                $.each(r.ebeneficio, function (i, eb) {
                    document.getElementById('check-' + eb.idcBeneficio).checked = true;
                    document.getElementById('div-' + eb.idcBeneficio).style.display = "block";
                    document.getElementById('input-' + eb.idcBeneficio).value = eb.valor;
                });
            },
            error: function (request, status, error) { }
        });
    }

