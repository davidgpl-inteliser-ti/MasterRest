                            </div>
                            <script>
                                var loadFile = function (event) {
                                    var img = document.getElementById('fotoPerfil');
                                    img.src = URL.createObjectURL(event.target.files[0]);
                                    img.onload = function () {
                                        URL.revokeObjectURL(img.src)
                                    }
                                };
                            </script>
