    function calcularAños(value) {
        var fechaNacimiento = $('#fechaNacimiento').val() != null && $('#fechaNacimiento').val() != "" ? $('#fechaNacimiento').val() : "";
        const años = moment().diff(fechaNacimiento, 'years');
        console.log(años);
        $('#edad').text( años+"" != "NaN" ? años + " años" : "");
    }

    $('#diasContrato').change(function () {
        var strDias = $(this).val();
        var strDate = document.getElementById("fechaInicialContrato").value;
        var parts = strDate.split('-');
        var date = new Date(parts[0], parts[1] - 1, parts[2]);
        date.setDate(date.getDate() + (parseInt(strDias) - 1));
        document.getElementById("fechaVencimientoContrato").value = date.toISOString().substring(0, 10);
    });

    function validarFecha_18_70(ff) {
        var fechaMin2 = new Date(new Date().setFullYear(new Date().getFullYear() - 70));
        var fechaMin = fechaMin2.setDate(fechaMin2.getDate() - 1);
        var fechaMax = new Date(new Date().setFullYear(new Date().getFullYear() - 18));
        var fecha = new Date(ff);
        if (fechaMin <= fecha && fecha <= fechaMax) {
            return ff;
        }
        var fechaMin3 = new Date(fechaMin2.setDate(fechaMin2.getDate() + 1));
        var d1 = fechaMin3.getDate();
        var m1 = fechaMin3.getMonth() + 1;
        var f1 = (d1 < 10 ? "0" + d1 : d1) + "-" + (m1 < 10 ? "0" + m1 : m1) + "-" + fechaMin3.getFullYear();
        var d2 = fechaMax.getDate();
        var m2 = fechaMax.getMonth() + 1;
        var f2 = (d2 < 10 ? "0" + d2 : d2) + "-" + (m2 < 10 ? "0" + m2 : m2) + "-" + fechaMax.getFullYear();
        swal("La fecha debe ser entre " + f1 + " y " + f2 + ".");
        return "";
    }

    function validarFecha_10(ff) {
        var fechaMin = new Date(new Date().setDate(new Date().getDate() - 10));
        var fechaMin2 = new Date(new Date().setDate(new Date().getDate() - 11));
        var fechaMax = new Date();
        var fecha = new Date(ff);
        if (fechaMin2 <= fecha && fecha <= fechaMax) {
            return ff;
        }
        var d1 = fechaMin.getDate();
        var m1 = fechaMin.getMonth() + 1;
        var f1 = (d1 < 10 ? "0" + d1 : d1) + "-" + (m1 < 10 ? "0" + m1 : m1) + "-" + fechaMin.getFullYear();
        var d2 = fechaMax.getDate();
        var m2 = fechaMax.getMonth() + 1;
        var f2 = (d2 < 10 ? "0" + d2 : d2) + "-" + (m2 < 10 ? "0" + m2 : m2) + "-" + fechaMax.getFullYear();
        swal("La fecha debe ser entre " + f1 + " y " + f2 + ".");
        return "";
    }

    function guardar() {
        var requiredCompleted = true;
        $('button.nav-link').each(function () {
            var btn = $(this);
            var div = $(btn.attr("data-bs-target"));
            var requiredEmpty = true;
            div.find('select, textarea, input').each(function () {
                if ($(this).prop('required') && $(this).val() == "") {
                    var controlName = $('label[for="' + $(this).attr('name') + '"]').html();
                    clearNav();
                    btn.addClass("active");
                    div.addClass("show active");
                    toast(controlName + " es obligatorio", "bg-warning");
                    requiredEmpty = false;
                    requiredCompleted = false;
                    return false;
                }
            });
            return requiredEmpty;
        });
        if (requiredCompleted) {
            swal({
                title: 'LLenado correctamente',
                html: '<p>Guardando <strong>por favor, espere...</strong>.</p>',
                type: 'success',
            });
            return requiredCompleted;
        }
    }

    var verSalario = false;
    function verAccesoRestringidoSalario2() {
        if (!verSalario) {
            var isOkay = false;
            swal({
                title: 'Acceso restringido',
                input: 'password',
                inputPlaceholder: 'Escriba su clave de seguridad',
                inputAttributes: { 'maxlength': 150, 'autocapitalize': 'off', 'autocorrect': 'off' },
                inputValidator: (value) => {
                    if (!value || (value !== "@ViewBag.clave")) return 'clave de seguridad incorrecta'
                    else { isOkay = true; return null }
                  }
            }).then(function (password) {
                if (isOkay) {
                    verSalario = true;
                    $("#salarioMensual").val("");
                    $("#salarioDiario").val("");
                    $("#salarioIntegrado").val("");
                    $("#salarioDiarioCotizacion").val("");
                    $("#salarioDiarioExcedente").val("");
                    $("#salarioMensual").prop("readonly", false);
                    $("#salarioDiarioCotizacion").prop("readonly", false);
                    $("#salarioDiarioExcedente").prop("readonly", false);
