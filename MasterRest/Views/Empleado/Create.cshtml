@model MasterRest.Models.mEmpleado
@{
    Layout = null;
}
<style>
    .upload-btn-wrapper
    {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .upload-btn-wrapper input[type=file]
    {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }

    .boton-standar-rw
    {
        margin: 5px;
        background-color: white;
        color: dimgray;
        border-radius: 20px;
        font-weight: bold;
        letter-spacing: 1px;
        line-height: 15px;
        border: 2px solid dimgray;
        transition: all 0.3s ease 0s;
        width: 9.7em;
        padding: 5px;
    }

    .boton-standar-rw:hover
    {
        color: white;
        background-color: rgb(245, 61, 58);
    }

    .toast.bs-toast .toast-header .btn-close
    {
        position: absolute;
        top: 8px !important;
        border-radius: 0.375rem;
        padding: 0.65rem;
        background-size: 0.7em;
        transition: all 0.23s ease 0.1s;
        background-color: #fff;
        box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.4);
        right: 20px !important;
    }

    .required::after
    {
        content: " *";
        font-weight: bold;
        color: red;
    }
</style>
@using (Html.BeginForm("Create", "Empleado", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return loading();", id = "frm" }))
{
    @Html.AntiForgeryToken()
