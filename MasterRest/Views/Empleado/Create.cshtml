    function obtenerDatosCURP() {
        var curp = $('#curp').val();
        var rfc = curp.substring(0, 10);
        var entidadFederativa = curp.substring(11, 13);
        var sexo = curp.substring(10, 11);
        var YY = curp.substring(4, 6);
        var MM = curp.substring(6, 8);
        var DD = curp.substring(8, 10);
        var YYYY = (parseInt(YY) < 45 ? '20' : '19') + YY;

        $('#rfc').val(rfc);
        $("#rfc").focus();

        $('#fechaNacimiento').val(YYYY + '-' + MM + '-' + DD);

        if (sexo == 'M') {
            $("#sexo").val("MUJER").change();
        } else {
            $("#sexo").val("HOMBRE").change();
        }

        if (entidadFederativa == 'NE') {
            $("#lugarNacimiento").val("NACIDO EN EL EXTRANJERO");
            $("#nacionalidad").val("EXTRANJERA").change();
        } else {
            $("#nacionalidad").val("MEXICANA").change();
            $.ajax({
                type: 'GET',
                url: '@Url.Action("entidadFederativa", "Empleado")',
                dataType: 'json',
                data: { claveCurp: entidadFederativa },
                success: function (result) {
                    $("#lugarNacimiento").val(result);
                },
                error: function (request, status, error) {
                    $("#lugarNacimiento").val("");
                }
            });
        }
    }

    function existeCURP(curp) {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("validarCURP", "Empleado")',
            dataType: 'json',
            data: { curp: curp },
            success: function (result) {
                if (result == "1") {
                    $('#curp').val('');
                    $('#curp').focus().select();
                    $('#errorCURP').text('Ya existe!');
                } else {
                    obtenerDatosCURP();
                }
            },
            error: function (request, status, error) {
                document.getElementById("curp").value = "";
            }
        });
    }

    function formatoCURP(curp) {

        var validado = curp.match(/^([A-Z][AEIOUX][A-Z]{2}\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])[HM](?:AS|B[CS]|C[CLMSH]|D[FG]|G[TR]|HG|JC|M[CNS]|N[ETL]|OC|PL|Q[TR]|S[PLR]|T[CSL]|VZ|YN|ZS)[B-DF-HJ-NP-TV-Z]{3}[A-Z\d])(\d)$/);

        if (validado==null)
            return false;

        function digitoVerificador(curp17) {
            var diccionario = "0123456789ABCDEFGHIJKLMNÑOPQRSTUVWXYZ",
                lngSuma = 0.0,
                lngDigito = 0.0;
            for (var i = 0; i < 17; i++)
                lngSuma = lngSuma + diccionario.indexOf(curp17.charAt(i)) * (18 - i);
            lngDigito = 10 - lngSuma % 10;
            if (lngDigito == 10) return 0;
            return lngDigito;
        }

        if (validado[2] != digitoVerificador(validado[1]))
            return false;

        return true;
    }

