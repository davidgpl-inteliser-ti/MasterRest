@model MasterRest.Models.mEmpleado
@{
    Layout = null;
}
<div class="col-xl-12">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs default-tabs mb-3">
            <li class="nav-item"><a href="#tab1" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">Personal</a></li>
            <li class="nav-item"><a href="#tab2" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Domicilio</a></li>
            <li class="nav-item"><a href="#tab3" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Estudios</a></li>
            <li class="nav-item"><a href="#tab4" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Contacto</a></li>
            <li class="nav-item"><a href="#tab5" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Nómina</a></li>
            <li class="nav-item"><a href="#tab6" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Sueldo</a></li>
            <li class="nav-item"><a href="#tab7" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Contratos</a></li>
            <li class="nav-item"><a href="#tab8" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Beneficios</a></li>
            <li class="nav-item"><a href="#tab9" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Documentación</a></li>
            <li class="nav-item"><a href="#tab10" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Movimientos</a></li>
            <li class="nav-item"><a href="#tab11" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Bajas</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane show active" id="tab1">
                <div class="form-group row">
                    <div class="col-lg-3">
                        <div class="d-flex align-items-start align-items-sm-center gap-4">
                            <img src="~/assets/img/avatar/avatar-1.jpg" class="d-block rounded" height="150" id="fotoPerfil" onclick="foto(this)" />
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div class="form-group row">
                            <div class="col-lg-4"><label><b>Nombre</b></label><br />@Model.nombre</div>
                            <div class="col-lg-4"><label><b>Apellido paterno</b></label><br />@Model.paterno</div>
                            <div class="col-lg-4"><label><b>Apellido materno</b></label><br />@Model.materno</div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <div class="col-lg-4"><label><b>CURP</b></label><br />@Model.curp</div>
                            <div class="col-lg-4"><label><b>RFC</b></label><br />@Model.rfc</div>
                            <div class="col-lg-4"><label><b>Sexo</b></label><br />@Model.sexo</div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <div class="col-lg-4"><label><b>Fecha de nacimiento</b></label><br />@(Model.fechaNacimiento != null ? ((DateTime)Model.fechaNacimiento).ToString("dd/MM/yyyy") : "")</div>
                            <div class="col-lg-4"><label><b>Lugar de nacimiento</b></label><br />@Model.lugarNacimiento</div>
                            <div class="col-lg-4"><label><b>Nacionalidad</b></label><br />@Model.nacionalidad</div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <div class="col-lg-4"><label><b>Edad</b></label><br />@ViewBag.edad años</div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Tipo de sangre</b></label><br />@Model.tipoSangre</div>
                    <div class="col-lg-3"><label><b>Estado civil</b></label><br />@Model.cEstadoCivil.estadoCivil</div>
                    <div class="col-lg-3"><label><b>Correo personal</b></label><br />@Model.correoPersonal</div>
                    <div class="col-lg-3"><label><b>Teléfono personal</b></label><br />@Model.telefono</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Teléfono contacto emerg.</b></label><br />@Model.telefonoContacto</div>
                    <div class="col-lg-3"><label><b>Nombre contacto emerg.</b></label><br />@Model.nombreContacto</div>
                    <div class="col-lg-3"><label><b>Parentesco contacto emerg.</b></label><br />@Model.parentescoContacto</div>
                </div>
            </div>
            <div class="tab-pane" id="tab2">
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Calle</b></label><br />@Model.dEmpleadoDomicilio.calle</div>
                    <div class="col-lg-3"><label><b>Número exterior</b></label><br />@Model.dEmpleadoDomicilio.noExterior</div>
                    <div class="col-lg-3"><label><b>Número interior</b></label><br />@Model.dEmpleadoDomicilio.noInterior</div>
                    <div class="col-lg-3"><label><b>Colonia</b></label><br />@Model.dEmpleadoDomicilio.colonia</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Entidad federativa</b></label><br />@Model.dEmpleadoDomicilio.cMunicipio.cEntidadFederativa.entidadFederativa</div>
                    <div class="col-lg-3"><label><b>Municipio</b></label><br />@Model.dEmpleadoDomicilio.cMunicipio.municipio</div>
                    <div class="col-lg-3"><label><b>Código postal</b></label><br />@Model.dEmpleadoDomicilio.codigoPostal</div>
                    <div class="col-lg-3"><label><b>Referencia</b></label><br />@Model.dEmpleadoDomicilio.referencia</div>
                </div>
            </div>
            <div class="tab-pane" id="tab3">
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Escolaridad</b></label><br />@Model.cEscolaridad.escolaridad</div>
                    <div class="col-lg-6"><label><b>Profesión</b></label><br />@Model.cProfesion.profesion</div>
                    <div class="col-lg-3"><label><b>Documento probatorio</b></label><br />@Model.documentoProbatorio</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-6"><label><b>Nombre de la institución</b></label><br />@Model.institucion</div>
                    <div class="col-lg-3"><label><b>Tipo de institución</b></label><br />@Model.tipoInstitucion</div>
                    <div class="col-lg-3"><label><b>Estatus de estudios</b></label><br />@Model.estatusInstitucion</div>
                </div>
            </div>
            <div class="tab-pane" id="tab4">
                <div class="form-group row">
                    <div class="col-lg-4"><label><b>Celular de la empresa</b></label><br />@Model.telefonoCelularEmpresa</div>
                    <div class="col-lg-4"><label><b>Teléfono fijo</b></label><br />@Model.telefonoFijoEmpresa</div>
                    <div class="col-lg-4"><label><b>Extensión</b></label><br />@Model.telefonoExtension</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-4"><label><b>Correo corporativo</b></label><br />@Model.correoCoorporativo</div>
                </div>
            </div>
            <div class="tab-pane" id="tab5">
                <div class="form-group row">
                    <div class="col-lg-4">
                        <label><b>Puesto</b></label><br /><font style="color:@(Model.estatus == "BAJA" ? "red" : "black")">@(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cPuesto.puesto : "")</font>
                        <p style="font-size:12px; color:gray; margin:0; padding:0;">
                            <b>Área</b> @(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cArea.area : "")<br />
                            <b>Sucursal</b> @(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cSucursal.sucursal : "")<br />
                            <b>Empresa</b> @(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cEmpresa.nombreComercial : "")<br />
                            <b>Razón social</b> @(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cEmpresa.razonSocial : "")<br />
                            <b>Rol</b> @(Model.mPlaza != null && Model.mPlaza.Count > 0 ? Model.mPlaza.FirstOrDefault().cRol.rol : "")<br />
                        </p>
                    </div>
                    <div class="col-md-4"><label><b>Jefe inmediato</b></label><br />@ViewBag.jefeInmediatoPuesto<br />@ViewBag.jefeInmediato</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Número de seguridad social</b></label><br />@Model.nss</div>
                    <div class="col-lg-3"><label><b>Fecha de ingreso al IMSS</b></label><br />@(Model.fechaIngresoImss != null ? ((DateTime)Model.fechaIngresoImss).ToString("dd/MM/yyyy") : "")</div>
                    <div class="col-lg-3"><label><b>Tipo de nómina</b></label><br />@Model.tipoNomina</div>
                    <div class="col-lg-3"><label><b>Esquema de pago</b></label><br />@Model.esquemaPago</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Fecha de ingreso</b></label><br />@(Model.fechaContratacion != null ? ((DateTime)Model.fechaContratacion).ToString("dd/MM/yyyy") : "")</div>
                    <div class="col-lg-3"><label><b>Código de banco</b></label><br />@ViewBag.banco</div>
                    <div class="col-lg-3"><label><b>Número de cuenta</b></label><br />@Model.noCuenta</div>
                    <div class="col-lg-3"><label><b>Clabe interbancaria</b></label><br />@Model.clabeInterbancaria</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Antigüedad</b></label><br />@ViewBag.antiguedad</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Número credito infonavit</b></label><br />@Model.noCreditoInfonavit</div>
                    <div class="col-lg-3"><label><b>Descuento infonavit</b></label><br />@Model.descuentoInfonavit</div>
                    <div class="col-lg-3"><label><b>Factor infonavit</b></label><br />@Model.factorInfonavit</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Número credito fonacot</b></label><br />@Model.noCreditoFonacot</div>
                    <div class="col-lg-3"><label><b>Descuento fonacot</b></label><br />@Model.descuentoFonacot</div>
                </div>
                <br />
            </div>
            <div class="tab-pane" id="tab6">
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Salario mensual: </b></label><br />@Model.salarioMensual</div>
                    <div class="col-lg-3"><label><b>Salario diario neto</b></label><br />@Model.salarioDiario</div>
                    <div class="col-lg-3"><label><b>Salario diario integrado</b></label><br />@Model.salarioIntegrado</div>
                </div>
                <br />
                <div class="form-group row">
                    <div class="col-lg-3"><label><b>Salario diario cotización</b></label><br />@Model.salarioDiarioCotizacion</div>
                    <div class="col-lg-3"><label><b>Salario diario excedente</b></label><br />@Model.salarioDiarioExcedente</div>
                </div>
            </div>
            <div class="tab-pane" id="tab7" style="overflow: scroll;">
                @if (Model.eEmpleadoContrato.Count > 0)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Contrato</th>
                                <th>Fecha inicial</th>
                                <th>Fecha final</th>
                                <th>Ver</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.eEmpleadoContrato)
                            {
                                <tr>
                                    <th>@c.noContrato</th>
                                    <th>@c.cTipoContrato.contrato</th>
                                    <th>@c.fechaInicial.ToString("dd/MM/yyyy")</th>
                                    <th>@(c.fechaFinal != null ? ((DateTime)c.fechaFinal).ToString("dd/MM/yyyy") : "")</th>
                                    <th>
                                        @if (c.ruta != null && c.ruta != "")
                                        {<a href="../@(Url.Content("~/").TrimStart('/') + c.ruta)?id=@(DateTime.Now.ToString("hhmmss"))" target="_blank"><i class="bx bxs-file-pdf me-1"></i></a>}
                                    </th>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No tiene contratos</p>
                }
            </div>
            <div class="tab-pane" id="tab8">
                @if (Model.mPlaza.Count > 0 && Model.mPlaza.FirstOrDefault().ePlazaBeneficio.Count > 0)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Beneficio</th>
                                <th>Tipo</th>
                                <th>Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.mPlaza.FirstOrDefault().ePlazaBeneficio)
                            {
                                <tr>
                                    <th>@b.cBeneficio.beneficio</th>
                                    <th>@b.tipo</th>
                                    <th>@b.valor</th>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No tiene beneficios</p>
                }
            </div>
            <div class="tab-pane" id="tab9">
                @if (Model.eEmpleadoDocumentacion.Count > 0)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Documento</th>
                                <th>Ver</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.eEmpleadoDocumentacion.OrderBy(_ => _.cDocumento.documento))
                            {
                                <tr>
                                    <th>@d.cDocumento.documento</th>
                                    <th><a href="../@(Url.Content("~/").TrimStart('/') + d.ruta)?id=@(DateTime.Now.ToString("hhmmss"))" target="_blank"><i class="bx bxs-file-pdf me-1"></i></a></th>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No tiene documentos</p>
                }
            </div>
            <div class="tab-pane" id="tab10">
                @if (Model.eEmpleadoPromocion.Count > 0)
                {
                    <div style="display: block; overflow-x: auto; white-space: nowrap;">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Motivo</th>
                                    <th>Fecha</th>
                                    <th>Sueldo anterior</th>
                                    <th>Sueldo actual</th>
                                    <th>Puesto anterior</th>
                                    <th>Puesto actual</th>
                                    <th>Área anterior</th>
                                    <th>Área actual</th>
                                    <th>Sucursal anterior</th>
                                    <th>Sucursal actual</th>
                                    <th>Jefe inmediato anterior</th>
                                    <th>Jefe inmediato actual</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.eEmpleadoPromocion)
                                {
                                    <tr>
                                        <th>@d.cMotivoMovimiento.motivo</th>
                                        <th>@(((DateTime)d.fechaMovimiento).ToString("dd/MM/yyyy"))</th>
                                        <th>@d.sueldoActual</th>
                                        <th>@d.sueldoNuevo</th>
                                        <th>@d.puestoActual</th>
                                        <th>@d.puestoNuevo</th>
                                        <th>@d.areaActual</th>
                                        <th>@d.areaNuevo</th>
                                        <th>@d.sucursalActual</th>
                                        <th>@d.sucursalNuevo</th>
                                        <th>@d.jefeInmediatoActual</th>
                                        <th>@d.jefeInmediatoNuevo</th>
                                        <th>@d.observaciones</th>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>No tiene movimientos</p>
                }
            </div>
            <div class="tab-pane" id="tab11">
                @if (Model.eEmpleadoBaja.Count > 0)
                {
                    <div style="display: block; overflow-x: auto; white-space: nowrap;">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Puesto</th>
                                    <th>Área</th>
                                    <th>Motivo</th>
                                    <th>Tipo</th>
                                    <th>Fecha de ingreso</th>
                                    <th>Fecha de baja</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.eEmpleadoBaja)
                                {
                                    <tr>
                                        <th>@d.puesto</th>
                                        <th>@d.area</th>
                                        <th>@d.motivoBaja</th>
                                        <th>@d.tipoBaja</th>
                                        <th>@(((DateTime)d.fechaAlta).ToString("dd/MM/yyyy"))</th>
                                        <th>@(((DateTime)d.fechaBaja).ToString("dd/MM/yyyy"))</th>
                                        <th>@d.observacionesBaja</th>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>No tiene baja</p>
                }
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">

    function foto(img) {
        window.open(img.src);
    }

    $(document).ready(function() {
        document.getElementById("fotoPerfil").src = window.location.origin + "@Url.Content("~/")" + "@(Model.fotoPerfil != null && Model.fotoPerfil != "" ? Model.fotoPerfil : "assets/img/avatar/avatar-1.jpg")?id=" + new Date().getTime();

        var seccion = '@ViewBag.seccion';
        if (seccion != null && seccion != "") {
            document.getElementById("btn-top-1").className = "nav-link";
            document.getElementById("navs-top-1").className = "tab-pane fade";
            switch (seccion) {
                case "Contratos":
                    document.getElementById("btn-top-6").className = "nav-link active";
                    document.getElementById("navs-top-6").className = "tab-pane fade show active";
                    break;
                case "Documentos":
                    document.getElementById("btn-top-8").className = "nav-link active";
                    document.getElementById("navs-top-8").className = "tab-pane fade show active";
                    break;
                case "Promociones":
                    document.getElementById("btn-top-9").className = "nav-link active";
                    document.getElementById("navs-top-9").className = "tab-pane fade show active";
                    break;
            }
        }
    });

    var verSalarioMovimiento = false;
    function verAccesoRestringidoSalarioMovimiento() {
        if (!verSalarioMovimiento) {
            var isOkay = false;
            swal({
                title: 'Acceso restringido',
                input: 'password',
                inputPlaceholder: 'Escriba su clave de seguridad',
                inputAttributes: { 'maxlength': 150, 'autocapitalize': 'off', 'autocorrect': 'off' },
                inputValidator: (value) => {
                    if (!value || (value !== "@ViewBag.clave")) return 'clave de seguridad incorrecta'
                    else { isOkay = true; return null }
                  }
            }).then(function (password) {
                if (isOkay) {
                    verSalarioMovimiento = true;
                    @foreach (var _ in Model.eEmpleadoPromocion) {
                        @:$("#sueldoActualMovimiento_@_.ideEmpleadoPromocion").text("@(_.sueldoActual)");
                        @:$("#sueldoNuevoMovimiento_@_.ideEmpleadoPromocion").text("@_.sueldoNuevo");
                    }
                    @*setTimeout(function () {
                        @foreach (var _ in Model.eEmpleadoPromocion) {
                            @:$("#sueldoActualMovimiento_@_.ideEmpleadoPromocion").text("********");
                            @:$("#sueldoNuevoMovimiento_@_.ideEmpleadoPromocion").text("********");
                        }
                    }, 2000);*@
                }
            })
        } else {
            verSalarioMovimiento = false;
            @foreach (var _ in Model.eEmpleadoPromocion) {
                @:$("#sueldoActualMovimiento_@_.ideEmpleadoPromocion").text("********");
                @:$("#sueldoNuevoMovimiento_@_.ideEmpleadoPromocion").text("********");
            }
        }
    }

    var verSalario = false;
    function verAccesoRestringidoSalario() {
        if (!verSalario) {
            var isOkay = false;
            swal({
                title: 'Acceso restringido',
                input: 'password',
                inputPlaceholder: 'Escriba su clave de seguridad',
                inputAttributes: { 'maxlength': 150, 'autocapitalize': 'off', 'autocorrect': 'off' },
                inputValidator: (value) => {
                    if (!value || (value !== "@ViewBag.clave")) return 'clave de seguridad incorrecta'
                    else { isOkay = true; return null }
                  }
            }).then(function (password) {
                if (isOkay) {
                    verSalario = true;
                    $("#salarioMensual").text("@Model.salarioMensual");
                    $("#salarioDiario").text("@Model.salarioDiario");
                    $("#salarioIntegrado").text("@Model.salarioIntegrado");
                    $("#salarioDiarioCotizacion").text("@Model.salarioDiarioCotizacion");
                    $("#salarioDiarioExcedente").text("@Model.salarioDiarioExcedente");
                    @*setTimeout(function () {
                        $("#salarioMensual").text("********");
                        $("#salarioDiario").text("********");
                        $("#salarioIntegrado").text("********");
                        $("#salarioDiarioCotizacion").text("********");
                        $("#salarioDiarioExcedente").text("********");
                    }, 2000);*@
                }
            })
        } else {
            verSalario = false;
            $("#salarioMensual").text("********");
            $("#salarioDiario").text("********");
            $("#salarioIntegrado").text("********");
            $("#salarioDiarioCotizacion").text("********");
            $("#salarioDiarioExcedente").text("********");
        }
    }
</script>