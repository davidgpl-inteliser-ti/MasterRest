@model MasterRest.Models.mEmpleado
@{
    Layout = null;
}
<style>
    .upload-btn-wrapper
    {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }
    .upload-btn-wrapper input[type=file]
    {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }
    .boton-standar-rw
    {
        margin: 5px;
        background-color: white;
        color: dimgray;
        border-radius: 20px;
        font-weight: bold;
        letter-spacing: 1px;
        line-height: 15px;
        border: 2px solid dimgray;
        transition: all 0.3s ease 0s;
        width: 9.7em;
        padding: 5px;
    }
        .boton-standar-rw:hover
        {
            color: white;
        }
    .toast.bs-toast .toast-header .btn-close
    {
        position: absolute;
        top: 8px !important;
        border-radius: 0.375rem;
        padding: 0.65rem;
        background-size: 0.7em;
        transition: all 0.23s ease 0.1s;
        background-color: #fff;
        box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.4);
        right: 20px !important;
    }
    .required::after
    {
        content: " *";
        font-weight: bold;
        color: red;
    }
</style>
@using (Html.BeginForm("Edit", "Empleado", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return loading();" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.idmEmpleado)
    @Html.HiddenFor(model => model.nombreCompleto)
    @Html.HiddenFor(model => model.iddDomicilio)
    @Html.HiddenFor(model => model.salarioMensual)
    @Html.HiddenFor(model => model.salarioDiario)
    @Html.HiddenFor(model => model.salarioIntegrado)
    @Html.HiddenFor(model => model.salarioDiarioCotizacion)
    @Html.HiddenFor(model => model.salarioDiarioExcedente)
    @Html.HiddenFor(model => model.fotoPerfil)
    @Html.HiddenFor(model => model.estatus)
    <div class="col-xl-12">
        <div class="nav-align-top mb-4">
            <ul class="nav nav-tabs default-tabs mb-3">
                <li class="nav-item"><a href="#tab1" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">Personal</a></li>
                <li class="nav-item"><a href="#tab2" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Domicilio</a></li>
                <li class="nav-item"><a href="#tab3" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Estudios</a></li>
                <li class="nav-item"><a href="#tab4" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Contacto</a></li>
                <li class="nav-item"><a href="#tab5" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Nómina</a></li>
                <li class="nav-item"><a href="#tab6" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Sueldo</a></li>
                <li class="nav-item"><a href="#tab7" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Contratos</a></li>
                <li class="nav-item"><a href="#tab8" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Beneficios</a></li>
                <li class="nav-item"><a href="#tab9" data-bs-toggle="tab" aria-expanded="false" class="nav-link">Documentación</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane show active" id="tab1">
                    <div class="form-group row">
                        <div class="col-lg-3">
                            <div class="upload-btn-wrapper">
                                <button class="boton-standar-rw">Foto perfil</button>
                                <input class="upload-file-buton" type="file" id="fileFoto" name="fileFoto" accept="image/gif, image/jpeg, image/png" onchange="loadFile(event)">
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-lg-3">
                            <div class="d-flex align-items-start align-items-sm-center gap-4">
                                <img src="~/assets/img/avatar/avatar-1.jpg" class="d-block rounded" height="150" id="fotoPerfilx" />
                            </div>
                            <script>
                                var loadFile = function (event) {
                                    var img = document.getElementById('fotoPerfilx');
                                    img.src = URL.createObjectURL(event.target.files[0]);
                                    img.onload = function () {
                                        URL.revokeObjectURL(img.src)
                                    }
                                };
                            </script>
                        </div>
                        <div class="col-lg-9">
                            <div class="form-group row">
                                <div class="col-lg-4">
                                    @Html.LabelFor(model => model.nombre, "Nombre", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", @required = "*", @maxlength = "100", @onkeyup = "this.value = textUppercase(this.value);" })
                                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-4">
                                    @Html.LabelFor(model => model.paterno, "Apellido paterno", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.paterno, new { @class = "form-control", @required = "*", @maxlength = "70", @onkeyup = "this.value = textUppercase(this.value);" })
                                    @Html.ValidationMessageFor(model => model.paterno, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-4">
                                    @Html.LabelFor(model => model.materno, "Apellido materno", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.materno, new { @class = "form-control", @maxlength = "70", @onkeyup = "this.value = textUppercase(this.value);" })
                                    @Html.ValidationMessageFor(model => model.materno, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <br />
                            <div class="form-group row">
                                <div class="col-lg-2">
                                    @Html.LabelFor(model => model.numeroEmpleado, "No. colab.", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.numeroEmpleado, new { @class = "form-control", @maxlength = "12", @required = "*", @onfocusout = "onFocusOutNE()" })
                                    @Html.ValidationMessageFor(model => model.numeroEmpleado, "", new { @class = "text-danger" })
                                    <div id="errorNE" style="color:red"></div>
                                </div>
                                <div class="col-lg-4">
                                    @Html.LabelFor(model => model.curp, "CURP", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.curp, new { @class = "form-control", @required = "*", @maxlength = "18", @onfocusout = "onFocusOutCURP()", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                                    @Html.ValidationMessageFor(model => model.curp, "", new { @class = "text-danger" })
                                    <div id="errorCURP" style="color:red"></div>
                                </div>
                                <div class="col-lg-3">
                                    @Html.LabelFor(model => model.rfc, "RFC", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.TextBoxFor(model => model.rfc, new { @class = "form-control", @required = "*", @maxlength = "13", @onfocusout = "onFocusOutRFC()", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                                    @Html.ValidationMessageFor(model => model.rfc, "", new { @class = "text-danger" })
                                    <div id="errorRFC" style="color:red"></div>
                                </div>
                                <div class="col-lg-3">
                                    @Html.LabelFor(model => model.sexo, "Sexo", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                                    @Html.DropDownList("sexo", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown"/*, @required = "*"*/ })
                                    @Html.ValidationMessageFor(model => model.sexo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.fechaNacimiento, "Fecha de nacimiento", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.fechaNacimiento, new { @class = "form-control"/*, @required = "*"*/, @type = "date", @Value = (Model.fechaNacimiento != null ? ((DateTime)Model.fechaNacimiento).ToString("yyyy-MM-dd") : ""), @onchange = "calcularAños(this.value)" })
                            @Html.ValidationMessageFor(model => model.fechaNacimiento, "", new { @class = "text-danger" })
                            <div id="edad" style="font-weight: bold;"></div>
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.lugarNacimiento, "Lugar de nacimiento", htmlAttributes: new { @class = "control-labe required", @style = "font-weight:bold" })
                            @Html.DropDownList("lugarNacimiento", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown"/*, @required = "*"*/ })
                            @Html.ValidationMessageFor(model => model.lugarNacimiento, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.nacionalidad, "Nacionalidad", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.DropDownList("nacionalidad", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown"/*, @required = "*"*/ })
                            @Html.ValidationMessageFor(model => model.nacionalidad, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.tipoSangre, "Tipo de sangre", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.DropDownList("tipoSangre", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.tipoSangre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.correoPersonal, "Correo personal", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.correoPersonal, new { @class = "form-control"/*, @required = "*"*/, @maxlength = "100" })
                            @Html.ValidationMessageFor(model => model.correoPersonal, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.estadoCivil, "Estado civil", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.DropDownList("estadoCivil", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown"/*, @required = "*"*/ })
                            @Html.ValidationMessageFor(model => model.estadoCivil, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-1">
                            @Html.LabelFor(model => model.hijos, "Hijos", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.hijos, new { @class = "form-control"/*, @required = "*"*/, @type = "number", @Value = Model.hijos, @min = 0, @max = 99, @onkeyup = "validNumberRange(this, 0, 99);" })
                            @Html.ValidationMessageFor(model => model.hijos, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-5">
                            <div id="divE" style="display: @(Model.hijos > 0 ? "block" : "none")">
                                @Html.LabelFor(model => model.hijosEdadXML, "Fechas nacimiento hijos", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                                @Html.HiddenFor(model => model.hijosEdadXML, new { htmlAttributes = new { @class = "form-control" } })
                                <div class="input-group">
                                    <input class="form-control" type="date" id="fechaNacimientoHijos" />
                                    <select class="form-select color-dropdown" id="sexoHijos">
                                        <option value="MUJER">MUJER</option>
                                        <option value="HOMBRE">HOMBRE</option>
                                    </select>
                                    <button type="button" class="btn btn-icon btn-success" onclick="addModalHEX();"><span class="tf-icons bx bx-send"></span></button>
                                </div>
                                <div class="input-group">
                                    <select class="form-select" id="shijosEdadXML">
                                        @if (Model.hijosEdadXML != null & Model.hijosEdadXML != "")
                                        {
                                            var x = 0;
                                            foreach (var f in Model.hijosEdadXML.Split('|'))
                                            {
                                                var arg = f.Replace(" ", "").Split('-');
                                                <option value="@arg[0] - @arg[1]" @(x == 0 ? "selected" : "")>@arg[0] - @arg[1]</option>
                                                x++;
                                            }
                                        }
                                    </select>
                                    <button type="button" class="btn btn-icon btn-warning" onclick="clearModalHEX();"><span class="tf-icons bx bx-minus"></span></button>
                                </div>
                                @Html.ValidationMessageFor(model => model.hijosEdadXML, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.telefono, "Teléfono personal", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.telefono, new { @class = "form-control"/*, @required = "*"*/, @maxlength = "10", @onfocusout = "onFocusOutTelefono('telefono')", @onkeypress = "return validNumbers(event);" })
                            @Html.ValidationMessageFor(model => model.telefono, "", new { @class = "text-danger" })
                            <div id="errortelefono" style="color:red"></div>
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.telefonoContacto, "Teléfono contacto emerg.", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.telefonoContacto, new { @class = "form-control"/*, @required = "*"*/, @maxlength = "10", @onfocusout = "onFocusOutTelefono('telefonoContacto')", @onkeypress = "return validNumbers(event);" })
                            @Html.ValidationMessageFor(model => model.telefonoContacto, "", new { @class = "text-danger" })
                            <div id="errortelefonoContacto" style="color:red"></div>
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.nombreContacto, "Nombre contacto emerg.", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.nombreContacto, new { @class = "form-control"/*, @required = "*"*/, @maxlength = "100", @onkeyup = "this.value = textUppercase(this.value);" })
                            @Html.ValidationMessageFor(model => model.nombreContacto, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.parentescoContacto, "Parentesco contacto emerg.", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.parentescoContacto, new { @class = "form-control"/*, @required = "*"*/, @maxlength = "100", @onkeyup = "this.value = textUppercase(this.value);" })
                            @Html.ValidationMessageFor(model => model.parentescoContacto, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab2">
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.Label("calle", "Calle", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBox("calle", null, new { @class = "form-control"/*, @required = "*"*/, @Value = Model.dEmpleadoDomicilio.calle, @maxlength = "150", @id = "calle", @name = "calle", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                            @Html.ValidationMessage("calle", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("noExterior", "Número exterior", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBox("noExterior", null, new { @class = "form-control"/*, @required = "*"*/, @Value = Model.dEmpleadoDomicilio.noExterior, @maxlength = "15", @id = "noExterior", @name = "noExterior", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                            @Html.ValidationMessage("noExterior", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("noInterior", "Número interior", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBox("noInterior", null, new { @class = "form-control", @Value = Model.dEmpleadoDomicilio.noInterior, @maxlength = "15", @id = "noInterior", @name = "noInteror", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                            @Html.ValidationMessage("noInterior", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("colonia", "Colonia", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBox("colonia", null, new { @class = "form-control"/*, @required = "*"*/, @Value = Model.dEmpleadoDomicilio.colonia, @maxlength = "150", @id = "colonia", @name = "colonia", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                            @Html.ValidationMessage("colonia", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.Label("idcEntidadFederativa", "Entidad federativa", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.DropDownList("idcEntidadFederativa", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*", @onchange = "OnChangeEntidadFederativa(this)" })
                            @Html.TextBox("entidadFederativa", null, new { @type = "hidden", @Value = Model.dEmpleadoDomicilio.entidadFederativa })
                            @Html.ValidationMessage("idcEntidadFederativa", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("idcMunicipio", "Municipio", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.DropDownList("idcMunicipio", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown", @required = "*", @onchange = "OnChangeMunicipio(this)" })
                            @Html.TextBox("municipio", null, new { @type = "hidden", @Value = Model.dEmpleadoDomicilio.municipio })
                            @Html.ValidationMessage("idcMunicipio", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("codigoPostal", "Código postal", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.TextBox("codigoPostal", null, new { @class = "form-control", @required = "*", @Value = Model.dEmpleadoDomicilio.codigoPostal, @maxlength = "6", @id = "codigoPostal", @name = "codigoPostal", @onkeypress = "return validNumbers(event);" })
                            @Html.ValidationMessage("codigoPostal", "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.Label("referencia", "Referencia", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBox("referencia", null, new { @class = "form-control", @Value = Model.dEmpleadoDomicilio.referencia, @maxlength = "250", @id = "referencia", @name = "referencia", @onkeyup = "this.value = textUppercaseNumbersComma(this.value);" })
                            @Html.ValidationMessage("referencia", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab3">
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.escolaridad, "Escolaridad", htmlAttributes: new { @class = "control-label required", @style = "font-weight:bold" })
                            @Html.DropDownList("escolaridad", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown"/*, @required = "*"*/ })
                            @Html.ValidationMessageFor(model => model.escolaridad, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-6">
                            @Html.LabelFor(model => model.profesion, "Profesión", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.DropDownList("profesion", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.profesion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.documentoProbatorio, "Documento probatorio", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.DropDownList("documentoProbatorio", null, "NO ESPECIFICADO", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.documentoProbatorio, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-6">
                            @Html.LabelFor(model => model.institucion, "Nombre de la institución", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.institucion, new { @class = "form-control", @onkeyup = "this.value = textUppercase(this.value);" })
                            @Html.ValidationMessageFor(model => model.institucion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.tipoInstitucion, "Tipo de institución", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.DropDownList("tipoInstitucion", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.tipoInstitucion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.estatusInstitucion, "Estatus de estudios", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.DropDownList("estatusInstitucion", null, "SELECCIONE...", htmlAttributes: new { @class = "form-select color-dropdown" })
                            @Html.ValidationMessageFor(model => model.estatusInstitucion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab4">
                    <div class="form-group row">
                        <div class="col-lg-4">
                            @Html.LabelFor(model => model.telefonoCelularEmpresa, "Celular de la empresa", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.telefonoCelularEmpresa, new { @class = "form-control", @maxlength = "10", @onfocusout = "onFocusOutTelefono('telefonoCelularEmpresa')", @onkeypress = "return validNumbers(event);" })
                            @Html.ValidationMessageFor(model => model.telefonoCelularEmpresa, "", new { @class = "text-danger" })
                            <div id="errortelefonoCelularEmpresa" style="color:red"></div>
