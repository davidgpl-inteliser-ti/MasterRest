                    @{
                        var total = ViewBag.beneficio.Count;
                        var totalx = total % 3 > 0 ? total / 3 + 1 : total / 3;
                        var i = 0;
                        for (int a = 0; a < totalx; a++)
                        {
                            <div class="form-group row">
                                @for (int b = 0; b < 3; b++)
                                {
                                    if (i < total)
                                    {
                                        var ben = (Model.mPlaza.Count() > 0) ? Model.mPlaza.FirstOrDefault().ePlazaBeneficio.FirstOrDefault(_ => _.idcBeneficio == ViewBag.beneficio[i].idcBeneficio) : new MasterRest.Models.ePlazaBeneficio();

                                        <div class="col-md-4">
                                            <input type="checkbox" class="form-check-input" id="check-@ViewBag.beneficio[i].idcBeneficio" name="check-@ViewBag.beneficio[i].idcBeneficio" onclick="OnClickTextVisible(this, '@ViewBag.beneficio[i].idcBeneficio');" @(ben != null ? "checked" : "") />
                                            <label style="font-size:12px; font-weight:bold" for="check-@ViewBag.beneficio[i].idcBeneficio"> @ViewBag.beneficio[i].beneficio</label>
                                            @if (ViewBag.beneficio[i].tipo == "IMPORTE" || ViewBag.beneficio[i].tipo == "PORCENTAJE")
                                            {
                                                <div id="div-@ViewBag.beneficio[i].idcBeneficio" style="display:@(ben != null ? "block" : "none")">
                                                    <div class="input-group" style="width:120px;">
                                                        @if (ViewBag.beneficio[i].tipo == "IMPORTE")
                                                        {
                                                            <span class="input-group-text">$</span>
                                                        }
                                                        <input type="text" class="form-control" id="input-@ViewBag.beneficio[i].idcBeneficio" name="input-@ViewBag.beneficio[i].idcBeneficio" value="@(ben != null && ben.valor != null ? ben.valor : "")" maxlength="6" onkeypress="return validNumbers2(event);">
                                                        @if (ViewBag.beneficio[i].tipo == "PORCENTAJE")
                                                        {
                                                            <span class="input-group-text">%</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (ViewBag.beneficio[i].tipo == "LISTA")
                                            {
                                                var opciones = ViewBag.beneficio[i].opciones.Split(',');

                                                <div id="div-@ViewBag.beneficio[i].idcBeneficio" style="display:@(ben != null ? "block" : "none")">
                                                    <select class="form-select " id="input-@ViewBag.beneficio[i].idcBeneficio" name="input-@ViewBag.beneficio[i].idcBeneficio" style="width:120px;">
                                                        <option value=""></option>
                                                        @foreach (var opcion in opciones)
                                                        {
                                                            <option value="@opcion" @(ben == null || ben.valor == null ? "" : (ben.valor == opcion ? "selected" : "") ) )>@opcion</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-6"></div>
                                    }
                                    i++;
                                }
                            </div>
                            <br />
                        }
                    }
                </div>
