                            '<a href="javascript:editarContrato(\'' + value.ideContrato + '\',\'' + value.idcContrato + '\',\'' + value.fechaInicial + '\',\'' + value.fechaFinal + '\',\'' + value.descripcion + '\',\'' + value.proyecto + '\',\'' + value.tiempoContrato + '\');"><i class="bx bxs-edit me-1"></i></a></th></tr>'
                    });
                    $("#tableContratos tbody").append(html);
                    $('#buttonContrato1').addClass("collapsed");
                    $('#accordionContrato1').removeClass("show");
                    $('#fileContrato').val('');
                    $('#ideContrato').val('');
                    $('#fechaInicial').val('');
                    $('#fechaFinal').val('');
                    $('#descripcion').val('');
                    $('#proyecto').val('');
                    $('#diasContrato').val('');
                    $('#idcContrato option:eq(0)').prop('selected', true);
                    $('#idcContrato').trigger('change');
                }
            });
        }
    }

    function OnChangeValidarNE(ne) {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("validarNE", "Empleado")',
            dataType: 'json',
            data: { ne: ne },
            success: function(result) {
                if (result == "1") {
                    document.getElementById("numeroEmpleado").value = "";
                    toast("El NE ya existe!<br/><b>" + ne + "</b>");
                }
            },
            error: function (request, status, error) {
                document.getElementById("numeroEmpleado").value = "";
            }
        });
    }

    function OnChangeEntidadFederativa(e) {
        $("#entidadFederativa").val(e.options[e.selectedIndex].innerHTML);
        $("#idcMunicipio").empty();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("municipios", "Empleado")',
            dataType: 'json',
            data: { id: e.value },
            success: function (items) {
                $.each(items, function (i, item) {
                    $("#idcMunicipio").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });
    }

    function OnChangeMunicipio(e) {
        $("#municipio").val(e.options[e.selectedIndex].innerHTML);
    }

    function calcula() {
        var salarioMensual = document.getElementById("salarioMensual2").value;
        if (salarioMensual != null && salarioMensual != "") {
            if (salarioMensual < 0) {
                document.getElementById("salarioMensual2").value = "";
                document.getElementById("salarioDiario2").value = "";
                document.getElementById("salarioIntegrado2").value = "";
            }
            if (salarioMensual >= 0) {
                var diasMes = ($("#tipoNomina option").filter(":selected").val() === 'SEMANAL') ? 30.4 : 30;
                var primaVacacional = 3.0;
                var aguinaldo = 15;
                var factor = ((primaVacacional + aguinaldo) / 365) + 1;
                $("#salarioDiario2").val(parseFloat(salarioMensual / diasMes).toFixed(2));
                $("#salarioIntegrado2").val(parseFloat(parseFloat(salarioMensual / diasMes) * factor).toFixed(2));
            }
        } else {
            $("#salarioDiario2").val('');
            $("#salarioIntegrado2").val('');
        }
    }

    function toast(msg, type) {
        $('div.toast-body').html(msg);
        const t = document.querySelector('.toast-placement-ex');
        t.classList.add(type);
        DOMTokenList.prototype.add.apply(t.classList, ["top-0", "end-0"]);
        let toastPlacement = new bootstrap.Toast(t);
        toastPlacement.show();
    }
</script>
