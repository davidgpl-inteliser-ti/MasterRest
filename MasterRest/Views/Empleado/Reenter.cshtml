        var entidadFederativa = curp.substring(11, 13);
        var sexo = curp.substring(10, 11);
        var YY = curp.substring(4, 6);
        var MM = curp.substring(6, 8);
        var DD = curp.substring(8, 10);
        var YYYY = (parseInt(YY) < 45 ? '20' : '19') + YY;

        $('#rfc').val(rfc);
        $("#rfc").focus();

        $('#fechaNacimiento').val(YYYY + '-' + MM + '-' + DD);

        if (sexo == 'M') {
            $("#sexo").val("MUJER").change();
        } else {
            $("#sexo").val("HOMBRE").change();
        }

        if (entidadFederativa == 'NE') {
            $("#lugarNacimiento").val("NACIDO EN EL EXTRANJERO");
        } else {
            $("#nacionalidad").val("MEXICANA").change();
            $.ajax({
