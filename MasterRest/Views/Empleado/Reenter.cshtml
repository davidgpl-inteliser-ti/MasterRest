    function calcula() {
        var salarioMensual = document.getElementById("salarioMensual").value;
        if (salarioMensual != null && salarioMensual != "") {
            if (salarioMensual < 0) {
                document.getElementById("salarioMensual").value = "";
            }
            if (salarioMensual >= 0) {
                var diasMes = ($("#tipoNomina option").filter(":selected").val() === 'SEMANAL') ? 30.4 : 30;
                var primaVacacional = 3.0;
                var aguinaldo = 15;
                var factor = ((primaVacacional + aguinaldo) / 365) + 1;
                $("#salarioDiario").val(parseFloat(salarioMensual / diasMes).toFixed(2));
                $("#salarioIntegrado").val(parseFloat(parseFloat(salarioMensual / diasMes) * factor).toFixed(2));
            }
        } else {
            $("#salarioDiario").val('');
            $("#salarioIntegrado").val('');
        }
    }

    function toast(msg, type) {
        $('div.toast-body').html(msg);
        const t = document.querySelector('.toast-placement-ex');
        t.classList.add(type);
        DOMTokenList.prototype.add.apply(t.classList, ["top-0", "end-0"]);
        let toastPlacement = new bootstrap.Toast(t);
        toastPlacement.show();
    }
