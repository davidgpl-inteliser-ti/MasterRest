<script src="~/assets/js/a-valid-input.js"></script>

<script type="text/javascript">

    $(function () {
        document.getElementById("fotoPerfil").src = "../@(Model.fotoPerfil != null && Model.fotoPerfil != "" ? Model.fotoPerfil : "assets/img/avatar/avatar-1.jpg")?" + new Date().getTime();
        $("#sexo").select2({ dropdownParent: $('#myModal3') });
        $("#nacionalidad").select2({ dropdownParent: $('#myModal3') });
        $("#tipoSangre").select2({ dropdownParent: $('#myModal3') });
        $("#estadoCivil").select2({ dropdownParent: $('#myModal3') });
        $("#idcEntidadFederativa").select2({ dropdownParent: $('#myModal3') });
        $("#idcMunicipio").select2({ dropdownParent: $('#myModal3') });
        $("#escolaridad").select2({ dropdownParent: $('#myModal3') });
        $("#profesion").select2({ dropdownParent: $('#myModal3') });
        $("#documentoProbatorio").select2({ dropdownParent: $('#myModal3') });
        $("#tipoInstitucion").select2({ dropdownParent: $('#myModal3') });
        $("#estatusInstitucion").select2({ dropdownParent: $('#myModal3') });
        $("#idmPlaza").select2({ dropdownParent: $('#myModal3') });
        $("#idmPlazaJefeInmediato").select2({ dropdownParent: $('#myModal3') });
        $("#tipoNomina").select2({ dropdownParent: $('#myModal3') });
        $("#isn").select2({ dropdownParent: $('#myModal3') });
        $("#codigoBanco").select2({ dropdownParent: $('#myModal3') });
        $("#idcContrato").select2({ dropdownParent: $('#myModal3') });
        $("#patronal").select2({ dropdownParent: $('#myModal3') });

        var fechaNacimiento = "@(Model.fechaNacimiento!= null ? ((DateTime)Model.fechaNacimiento).ToString("yyyy-MM-dd") : "")";
        const años = moment().diff(fechaNacimiento, 'years');
        $('#edad').text(años + "" != "NaN" ? años + " años" : "");
    });

    function calcularAños(value) {
        var fechaNacimiento = $('#fechaNacimiento').val() != null && $('#fechaNacimiento').val() != "" ? $('#fechaNacimiento').val() : "";
        const años = moment().diff(fechaNacimiento, 'years');
        $('#edad').text(años + "" != "NaN" ? años + " años" : "");
    }

    $("#idcContrato").change(function () {
        document.getElementById("divD").style.display = $('#idcContrato').val() == 7 ? "block" : "none";
        document.getElementById("divC").style.display = $('#idcContrato').val() == 4 || $('#idcContrato').val() == "" ? "none" : "block";
    });

    $('#diasContrato').change(function () {
        var strDias = $(this).val();
        var strDate = document.getElementById("fechaInicial").value;
        var parts = strDate.split('-');
        var date = new Date(parts[0], parts[1] - 1, parts[2]);
        date.setDate(date.getDate() + (parseInt(strDias) - 1));
        document.getElementById("fechaFinal").value = date.toISOString().substring(0, 10);
    });

    function guardar() {
        var requiredCompleted = true;
        $('button.nav-link').each(function () {
            var btn = $(this);
            var div = $(btn.attr("data-bs-target"));
            var requiredEmpty = true;
            div.find('select, textarea, input').each(function () {
                if ($(this).prop('required') && $(this).val() == "") {
                    var controlName = $('label[for="' + $(this).attr('name') + '"]').html();
                    clearNav();
                    btn.addClass("active");
                    div.addClass("show active");
                    toast(controlName + " es obligatorio", "bg-warning");
                    requiredEmpty = false;
                    requiredCompleted = false;
                    return false;
                }
            });
            return requiredEmpty;
        });
        if (requiredCompleted) {
            swal({
                title: 'LLenado correctamente',
                html: '<p>Guardando <strong>por favor, espere...</strong>.</p>',
                type: 'success',
            });
            return requiredCompleted;
        }
    }

    var verSalario = false;
