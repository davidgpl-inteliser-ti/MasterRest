@model MasterRest.Models.mEmpleado
@{
    Layout = null;

    var sesion = Session["GV"] as MasterRest.Entities.Session;
}
<style>
    .upload-btn-wrapper
    {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

        .upload-btn-wrapper input[type=file]
        {
            font-size: 100px;
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
        }

    .boton-standar-rw
    {
        margin: 5px;
        background-color: white;
        color: dimgray;
        border-radius: 20px;
        font-weight: bold;
        letter-spacing: 1px;
        line-height: 15px;
        border: 2px solid dimgray;
        transition: all 0.3s ease 0s;
        width: 9.7em;
        padding: 5px;
    }

        .boton-standar-rw:hover
        {
            color: white;
            background-color: rgb(245, 61, 58);
        }

    .toast.bs-toast .toast-header .btn-close
    {
        position: absolute;
        top: 8px !important;
        border-radius: 0.375rem;
        padding: 0.65rem;
        background-size: 0.7em;
        transition: all 0.23s ease 0.1s;
        background-color: #fff;
        box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.4);
        right: 20px !important;
    }

    .required::after
    {
        content: " *";
        font-weight: bold;
        color: red;
    }
</style>
@using (Html.BeginForm("Salary", "Empleado", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return loading();" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.idmEmpleado)
    @Html.HiddenFor(model => model.iddDomicilio)
    @Html.HiddenFor(model => model.numeroEmpleado)
    @Html.HiddenFor(model => model.nombreCompleto)
    @Html.HiddenFor(model => model.paterno)
    @Html.HiddenFor(model => model.materno)
    @Html.HiddenFor(model => model.nombre)
    @Html.HiddenFor(model => model.fechaAlta)
    @Html.HiddenFor(model => model.fechaNacimiento)
    @Html.HiddenFor(model => model.lugarNacimiento)
    @Html.HiddenFor(model => model.curp)
    @Html.HiddenFor(model => model.rfc)
    @Html.HiddenFor(model => model.nss)
    @Html.HiddenFor(model => model.fechaIngresoImss)
    @Html.HiddenFor(model => model.estadoCivil)
    @Html.HiddenFor(model => model.hijos)
    @Html.HiddenFor(model => model.hijosEdadXML)
    @Html.HiddenFor(model => model.nacionalidad)
    @Html.HiddenFor(model => model.sexo)
    @Html.HiddenFor(model => model.tipoSangre)
    @Html.HiddenFor(model => model.correoPersonal)
    @Html.HiddenFor(model => model.correoCoorporativo)
    @Html.HiddenFor(model => model.telefonoFijoEmpresa)
    @Html.HiddenFor(model => model.telefonoExtension)
    @Html.HiddenFor(model => model.telefonoCelularEmpresa)
    @Html.HiddenFor(model => model.telefono)
    @Html.HiddenFor(model => model.telefonoContacto)
    @Html.HiddenFor(model => model.nombreContacto)
    @Html.HiddenFor(model => model.parentescoContacto)
    @Html.HiddenFor(model => model.escolaridad)
    @Html.HiddenFor(model => model.documentoProbatorio)
    @Html.HiddenFor(model => model.profesion)
    @Html.HiddenFor(model => model.institucion)
    @Html.HiddenFor(model => model.tipoInstitucion)
    @Html.HiddenFor(model => model.estatusInstitucion)
    @Html.HiddenFor(model => model.esquemaPago)
    @Html.HiddenFor(model => model.tipoNomina)
    @Html.HiddenFor(model => model.noCreditoInfonavit)
    @Html.HiddenFor(model => model.descuentoInfonavit)
    @Html.HiddenFor(model => model.factorInfonavit)
    @Html.HiddenFor(model => model.noCreditoFonacot)
    @Html.HiddenFor(model => model.descuentoFonacot)
    @Html.HiddenFor(model => model.factorFonacot)
    @Html.HiddenFor(model => model.codigoBanco)
    @Html.HiddenFor(model => model.codigoSucursal)
    @Html.HiddenFor(model => model.noCuenta)
    @Html.HiddenFor(model => model.clabeInterbancaria)
    @Html.HiddenFor(model => model.salarioMensual)
    @Html.HiddenFor(model => model.salarioDiario)
    @Html.HiddenFor(model => model.salarioIntegrado)
    @Html.HiddenFor(model => model.salarioDiarioExcedente)
    @Html.HiddenFor(model => model.salarioDiarioCotizacion)
    @Html.HiddenFor(model => model.fotoPerfil)
    @Html.HiddenFor(model => model.observaciones)
    @Html.HiddenFor(model => model.estatus)
    <div class="col-xl-12">
        <div class="nav-align-top mb-4">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="navs-top-9">
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.salarioMensual, "Salario mensual", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.salarioMensual, new { @class = "form-control", @id = "salarioMensual2", onblur = "calcula();", @placeholder = "0.00", @readonly = "readonly", @minlength = "0", @maxlength = "10", @onkeypress = "return validNumbers3(event, this);", @onfocusout = "if(this.value=='.'){this.value='';}else if(this.value.substring(0,1)=='.'){this.value='0'+this.value}else if(this.value.substring(this.value.length-1)=='.'){this.value=this.value.substring(0, this.value.length - 1)}" })
                            @Html.ValidationMessageFor(model => model.salarioMensual, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.salarioDiario, "Salario diario neto", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.salarioDiario, new { @class = "form-control", @id = "salarioDiario2", @readonly = "readonly", @placeholder = "0.00" })
                            @Html.ValidationMessageFor(model => model.salarioDiario, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.salarioIntegrado, "Salario diario integrado", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.salarioIntegrado, null, new { @class = "form-control", @id = "salarioIntegrado2", @readonly = "readonly", @placeholder = "0.00" })
                            @Html.ValidationMessageFor(model => model.salarioIntegrado, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="form-group row">
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.salarioDiarioCotizacion, "Salario diario cotización", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.salarioDiarioCotizacion, new { @class = "form-control", @id = "salarioDiarioCotizacion2", @placeholder = "0.00", @readonly = "readonly", @minlength = "0", @maxlength = "10", @onkeypress = "return validNumbers3(event, this);", @onfocusout = "if(this.value=='.'){this.value='';}else if(this.value.substring(0,1)=='.'){this.value='0'+this.value}else if(this.value.substring(this.value.length-1)=='.'){this.value=this.value.substring(0, this.value.length - 1)}" })
                            @Html.ValidationMessageFor(model => model.salarioDiarioCotizacion, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.salarioDiarioExcedente, "Salario diario excedente", htmlAttributes: new { @class = "control-label", @style = "font-weight:bold" })
                            @Html.TextBoxFor(model => model.salarioDiarioExcedente, new { @class = "form-control", @id = "salarioDiarioExcedente2", @placeholder = "0.00", @readonly = "readonly", @minlength = "0", @maxlength = "10", @onkeypress = "return validNumbers3(event, this);", @onfocusout = "if(this.value=='.'){this.value='';}else if(this.value.substring(0,1)=='.'){this.value='0'+this.value}else if(this.value.substring(this.value.length-1)=='.'){this.value=this.value.substring(0, this.value.length - 1)}" })
                            @Html.ValidationMessageFor(model => model.salarioDiarioExcedente, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
        <div class="form-group col-md-12">
            <div style="position: relative; float: right;">
                <input type="submit" value="Guardar" class="btn btn-primary" onclick='return guardar()' style="margin-top:22px" />
            </div>
        </div>
    </div>
    <div class="bs-toast toast toast-placement-ex m-2" role="alert" aria-live="assertive" aria-atomic="true" data-delay="500">
        <div class="toast-header">
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body"></div>
    </div>
}

<script src="~/assets/js/a-valid-input.js"></script>

<script type="text/javascript">

    function guardar() {
        var requiredCompleted = true;
        $('button.nav-link').each(function () {
            var btn = $(this);
            var div = $(btn.attr("data-bs-target"));
            var requiredEmpty = true;
            div.find('select, textarea, input').each(function () {
                if ($(this).prop('required') && $(this).val() == "") {
                    var controlName = $('label[for="' + $(this).attr('name') + '"]').html();
                    clearNav();
                    btn.addClass("active");
                    div.addClass("show active");
                    toast(controlName + " es obligatorio", "bg-warning");
                    requiredEmpty = false;
                    requiredCompleted = false;
                    return false;
                }
            });
            return requiredEmpty;
        });
        if (requiredCompleted) {
            swal({
                title: 'LLenado correctamente',
                html: '<p>Guardando <strong>por favor, espere...</strong>.</p>',
                type: 'success',
            });
            return requiredCompleted;
        }
    }

    function calcula() {
        var salarioMensual = document.getElementById("salarioMensual2").value;
        if (salarioMensual != null && salarioMensual != "") {
            if (salarioMensual < 0) {
                document.getElementById("salarioMensual2").value = "";
                document.getElementById("salarioDiario2").value = "";
                document.getElementById("salarioIntegrado2").value = "";
            }
            if (salarioMensual >= 0) {
                var diasMes = ($("#tipoNomina option").filter(":selected").val() === 'SEMANAL') ? 30.4 : 30;
                var primaVacacional = 3.0;
                var aguinaldo = 15;
                var factor = ((primaVacacional + aguinaldo) / 365) + 1;
                $("#salarioDiario2").val(parseFloat(salarioMensual / diasMes).toFixed(2));
                $("#salarioIntegrado2").val(parseFloat(parseFloat(salarioMensual / diasMes) * factor).toFixed(2));
            }
        } else {
            $("#salarioDiario2").val('');
            $("#salarioIntegrado2").val('');
        }
    }

    function toast(msg, type) {
        $('div.toast-body').html(msg);
        const t = document.querySelector('.toast-placement-ex');
        t.classList.add(type);
        DOMTokenList.prototype.add.apply(t.classList, ["top-0", "end-0"]);
        let toastPlacement = new bootstrap.Toast(t);
        toastPlacement.show();
    }
</script>